# Copy to backend/.env and adjust. Never commit the real .env.

DEBUG=True

# REQUIRED. No fallback exists in settings.py on purpose.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# With DEBUG=False the value must be >= 50 chars and must not be a placeholder
# (anything starting with dev-/test-/django-insecure- is rejected at startup).
SECRET_KEY=dev-only-change-me

# Optional: sign JWTs with a key that can be rotated independently of
# SECRET_KEY. Defaults to SECRET_KEY when unset.
# JWT_SIGNING_KEY=

# Comma separated. Must be non-empty and must not contain '*' when DEBUG=False.
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite in dev; swap for postgres://user:pass@host:5432/clickup in prod
DATABASE_URL=sqlite:///db.sqlite3

# Leave empty in dev to use the in-memory channel layer + local-memory cache.
# In production this must be set: throttle counters live in the cache and are
# only correct when every worker shares one backend.
REDIS_URL=

# --- Celery (background jobs) ---
# Both default to REDIS_URL. When the resulting broker URL is EMPTY — the
# normal dev setup — Celery runs in eager mode: every .delay() executes
# inline, in the calling process, so the app is fully functional with no
# worker and no broker. Nothing is silently skipped.
#
# In production set REDIS_URL (or these two) and run the two processes:
#   celery -A config worker -l info      # executes the jobs
#   celery -A config beat   -l info      # emits the periodic schedule
# Use a DIFFERENT redis database index than the channel layer/cache if you
# want the queues isolated, e.g. redis://redis:6379/1
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=
# Force inline execution even when a broker is configured (local debugging).
# CELERY_TASK_ALWAYS_EAGER=False
# Per-task limits in seconds; the soft one raises SoftTimeLimitExceeded first.
# CELERY_TASK_SOFT_TIME_LIMIT=600
# CELERY_TASK_TIME_LIMIT=660

# Soft-deleted Task/Comment/Message rows are hard-deleted this many days after
# they were deleted (docs/adr/0003-soft-delete.md). The `core.purge_soft_deleted`
# job runs nightly at 03:30 Asia/Tashkent; `manage.py purge_soft_deleted` does
# the same thing by hand (dry-run unless you pass --yes).
# 0 or a negative value DISABLES the purge — it does not mean "purge everything".
SOFT_DELETE_RETENTION_DAYS=30
# Rows deleted per transaction, so one purge never holds a long table lock.
# PURGE_BATCH_SIZE=500

CORS_ALLOWED_ORIGINS=http://localhost:3000
# Origins allowed to open a WebSocket, on top of ALLOWED_HOSTS. Needed when the
# SPA is served from a different host than the API (e.g. https://app.example.com).
WS_ALLOWED_ORIGINS=
# Required by Django for cross-origin POSTs to the admin behind a proxy.
# Full origins with scheme, e.g. https://api.example.com
CSRF_TRUSTED_ORIGINS=

ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# Invitations expire created_at + INVITATION_TTL_DAYS
INVITATION_TTL_DAYS=7

# Number of trusted reverse proxies in front of the app. DEFAULT IS 0 and the
# default is the safe one: with 0, X-Forwarded-For is ignored entirely and the
# throttle identity is REMOTE_ADDR.
#
# Why this matters: DRF picks addrs[-min(NUM_PROXIES, len(addrs))] out of
# X-Forwarded-For. Set it to 1 with no real proxy in front and the only entry
# in that header is the one the CLIENT sent, so `X-Forwarded-For: <anything>`
# becomes the rate-limit bucket -- rotate the header, and auth / register /
# demo / invite_lookup / avatar throttles all stop existing.
#
# Only raise this to the number of proxies YOU control and that always rewrite
# the header (e.g. 1 behind a single nginx/ALB). Too high is just as broken as
# too low: it reads an entry the client can still choose.
NUM_PROXIES=0

# DRF scoped throttle rates ("<count>/<second|minute|hour|day>")
# auth       -> login, per source address
# auth_burst -> login, per submitted email address (credential stuffing)
AUTH_THROTTLE_RATE=10/min
AUTH_BURST_THROTTLE_RATE=5/min
# refresh    -> POST auth/refresh/, per source address.
# That endpoint is AllowAny (a client needing a new access token has no valid
# one to authenticate with) and every SUCCESSFUL call writes twice: it rotates
# the refresh token and blacklists the old one. Unbounded, that is anonymous
# write amplification into the SimpleJWT tables.
# Deliberately LOOSE, and that is the point: the key is the source address, so
# with NUM_PROXIES set correctly a whole office behind one NAT address shares a
# single bucket. A tight limit would lock out real users long before it
# inconvenienced an attacker with a proxy pool; 30/min only turns "unbounded"
# into "bounded and alertable". Raise it for E2E/CI runs that mint many
# sessions.
REFRESH_THROTTLE_RATE=30/min
REGISTER_THROTTLE_RATE=5/hour
PASSWORD_CHANGE_THROTTLE_RATE=5/hour
INVITE_THROTTLE_RATE=20/hour
INVITE_LOOKUP_THROTTLE_RATE=30/hour
AVATAR_THROTTLE_RATE=10/hour
# attachment -> POST tasks/{id}/attachments/, per user
ATTACHMENT_THROTTLE_RATE=30/hour
COMMENT_THROTTLE_RATE=60/min
# demo -> POST auth/demo/, per source address
DEMO_THROTTLE_RATE=10/hour
# One-shot WebSocket handshake tickets (§15.1). Kept generous: a reconnect
# loop needs a fresh ticket every time, and the ticket carries no claims.
REALTIME_TICKET_THROTTLE_RATE=60/min
# showcase -> GET public/showcase/, per source address. Anonymous and
# uncached, and it runs several COUNT(*) queries.
SHOWCASE_THROTTLE_RATE=60/min

# --- Public landing content (GET public/showcase/) ---
# The marketing landing at `/` is only ever rendered for signed-out visitors,
# so it reads this ONE anonymous endpoint instead of shipping hardcoded
# mock rows. Aggregate counts and the permission catalog are always returned;
# workspace CONTENT (space names, task titles, activity feed) is returned only
# when the id below is set.
#
# Empty = no record of anyone's is exposed anonymously. That is the default and
# the right setting for production unless you deliberately want a public demo.
# Whatever you put here must be treated as WORLD-READABLE. User emails are
# never included (initials only) and private spaces are never named, but every
# task title in the workspace's public spaces becomes visible to the internet.
SHOWCASE_WORKSPACE_ID=

# "Demo rejimda kirish": POST auth/demo/ hands out a token pair for
# DEMO_USER_EMAIL with no password. Anyone who can reach the API can use it —
# keep it False outside local development. The endpoint 404s when off, when the
# account is missing, and when the account is staff/superuser.
DEMO_MODE=False
DEMO_USER_EMAIL=mehmon@clickish.dev

# --- Task attachments (API_CONTRACT §10.7) ---
# Maximum size of a single attachment, in MB. The extension/MIME allow-list is
# fixed in code (apps/tasks/attachments.py): svg, html, js, exe, bat and sh are
# rejected outright — an inline SVG is a stored-XSS vector.
MAX_ATTACHMENT_MB=10
# Non-file part of a multipart body / in-memory upload threshold, in bytes.
# DATA_UPLOAD_MAX_MEMORY_SIZE=2621440
# FILE_UPLOAD_MAX_MEMORY_SIZE=2621440
# DATA_UPLOAD_MAX_NUMBER_FILES=10

# Admin lives here. STRONGLY RECOMMENDED: change this in production to a
# long, non-guessable path (e.g. `ADMIN_URL=k7q2-panel-9f3x/`). The default
# `/admin/` is the first thing every scanner and credential-stuffing bot
# probes; moving it removes that background noise entirely. It is obscurity,
# not a control -- it does NOT replace strong staff passwords / MFA, and
# `/admin/` login attempts are logged as `auth.login_failed` (WARNING).
# Must end with a trailing slash and contain no leading slash.
ADMIN_URL=admin/

# /api/schema/ and /api/docs/ are always on with DEBUG=True. With DEBUG=False
# they are not routed at all unless this is true (and then staff-only).
EXPOSE_API_DOCS=False

# json (default with DEBUG=False) or console
LOG_FORMAT=console
LOG_LEVEL=DEBUG

# --- Error tracking (Sentry) ---
# OPTIONAL and off by default. Leave SENTRY_DSN empty and nothing is imported,
# no client is created and no network call is ever made.
#
# Requires the `sentry-sdk` package. It is deliberately NOT a hard dependency:
# settings.py imports it inside try/except ImportError, so a deployment that
# sets a DSN without installing the package still boots (it logs a WARNING and
# runs with error tracking off). To actually enable it, add `sentry-sdk` to
# backend/requirements.txt.
#
# PII is off (`send_default_pii=False`, `max_request_body_size="never"`):
# no emails, no auth headers, no cookies, no request bodies, no client IPs.
# The JSON log formatter is kept as-is; Sentry hooks into it via
# LoggingIntegration (INFO+ -> breadcrumbs, ERROR+ -> issues), and every
# unhandled exception already carries the same `request_id` in both sinks.
SENTRY_DSN=
# Shown as the environment tag on every issue.
# SENTRY_ENVIRONMENT=production
# Usually the git SHA; lets Sentry mark regressions and resolved-in releases.
# SENTRY_RELEASE=
# Performance tracing sample rate, 0.0-1.0. 0.0 = errors only (default).
# SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Only read when DEBUG=False ---
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SESSION_COOKIE_AGE=43200
