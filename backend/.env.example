# Copy to backend/.env and adjust. Never commit the real .env.

DEBUG=True
SECRET_KEY=dev-only-change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite in dev; swap for postgres://user:pass@host:5432/clickup in prod
DATABASE_URL=sqlite:///db.sqlite3

# Leave empty in dev to use the in-memory channel layer
REDIS_URL=

CORS_ALLOWED_ORIGINS=http://localhost:3000

ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# Invitations expire created_at + INVITATION_TTL_DAYS
INVITATION_TTL_DAYS=7

# DRF scoped throttle rates (auth = register/login, comments = comment creation)
AUTH_THROTTLE_RATE=60/min
COMMENT_THROTTLE_RATE=120/min
