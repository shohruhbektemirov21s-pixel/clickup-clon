# Build context = ./frontend (see docker-compose.yml)

# Node / Vite — node_modules comes from the `deps` stage, never from the host
node_modules/
dist/
out/
build/
*.tsbuildinfo
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Secrets / local env
.env
.env.*
!.env.example

# Playwright — E2E specs are not part of the production build. Keeping them out
# of the context also stops a type error in a test from failing `npm run build`
# (`tsc -b` tsconfig `include` bo'yicha yuradi).
e2e/
playwright.config.ts
test-results/
playwright-report/
blob-report/
.cache/

# VCS / editors / OS
.git/
.gitignore
.github/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Docs and container files
*.md
Dockerfile
.dockerignore
