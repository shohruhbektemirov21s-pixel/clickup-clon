# Docker build contexts: private/corporate root CAs for TLS-inspecting
# networks. Machine-specific, never committed; the empty dir must stay so the
# Dockerfile COPY still resolves. See docs/DOCKER.md.
backend/ca/*
frontend/ca/*
!backend/ca/.gitkeep
!frontend/ca/.gitkeep

# Qo'lda olingan baza zaxiralari (haqiqiy ma'lumot bo'ladi)
db.sqlite3.bak-*
*.sqlite3.bak-*

# mypy lokal ishga tushirilganda yozadi (CI ham shu nomni ishlatadi)
