# Copy to the repo-root .env before running docker compose:
#
#   cp .env.docker.example .env        (PowerShell: Copy-Item .env.docker.example .env)
#
# The real .env is gitignored — NEVER commit it, and never put a real secret in
# this example file. Kept in sync with backend/.env.example; the extra blocks
# here are the ones only the container stack needs.
#
# Compose reads this file twice: for ${VAR} substitution inside
# docker-compose.yml, and as the backend container's env_file.

# ---------------------------------------------------------------- PostgreSQL
# Consumed by the `db` service and interpolated into DATABASE_URL by compose.
POSTGRES_DB=clickup
POSTGRES_USER=clickup
POSTGRES_PASSWORD=change-me-locally
# Host-side port for psql/GUI clients (dev only; unpublished in prod).
POSTGRES_PORT=5432

# --------------------------------------------------------------------- Redis
# Host-side port (dev only). The Channels layer and the cache always use
# redis://redis:6379/0 on the compose network — set in docker-compose.yml.
REDIS_PORT=6379

# ------------------------------------------------------------- Django backend
DEBUG=True

# REQUIRED. No fallback exists in settings.py on purpose.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# With DEBUG=False the value must be >= 50 chars and must not be a placeholder
# (anything starting with dev-/test-/django-insecure- is rejected at startup),
# so this dev value MUST be replaced before using docker-compose.prod.yml.
SECRET_KEY=dev-only-change-me

# Optional: sign JWTs with a key that can be rotated independently of
# SECRET_KEY. Defaults to SECRET_KEY when unset.
# JWT_SIGNING_KEY=

# Comma separated. Must be non-empty and must not contain '*' when DEBUG=False.
# `backend` is the compose service name; 127.0.0.1 is what the container
# HEALTHCHECK requests.
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# NOTE: DATABASE_URL and REDIS_URL are NOT set here. docker-compose.yml builds
# them from the values above and injects them as real environment variables,
# which take precedence over any .env file (django-environ uses setdefault).
# Only set them here if you point the stack at an external DB/Redis.

CORS_ALLOWED_ORIGINS=http://localhost:3000
# Origins allowed to open a WebSocket, on top of ALLOWED_HOSTS.
WS_ALLOWED_ORIGINS=
# Full origins with scheme, e.g. https://api.example.com
CSRF_TRUSTED_ORIGINS=

ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# Invitations expire created_at + INVITATION_TTL_DAYS
INVITATION_TTL_DAYS=7

# Number of trusted reverse proxies in front of the app. 0 for the dev stack:
# nothing proxies the backend, the host talks to it directly. Set to 1 in prod,
# where nginx/Caddy/Traefik terminates TLS in front of it.
NUM_PROXIES=0

# DRF scoped throttle rates ("<count>/<second|minute|hour|day>")
AUTH_THROTTLE_RATE=10/min
AUTH_BURST_THROTTLE_RATE=5/min
REGISTER_THROTTLE_RATE=5/hour
PASSWORD_CHANGE_THROTTLE_RATE=5/hour
INVITE_THROTTLE_RATE=20/hour
INVITE_LOOKUP_THROTTLE_RATE=30/hour
AVATAR_THROTTLE_RATE=10/hour
COMMENT_THROTTLE_RATE=60/min

# Admin lives here. Change it in production.
ADMIN_URL=admin/

# /api/schema/ and /api/docs/ are always on with DEBUG=True. With DEBUG=False
# they are not routed at all unless this is true (and then staff-only).
EXPOSE_API_DOCS=False

# json (default with DEBUG=False) or console. `json` reads better through
# `docker compose logs` once you ship them to a log aggregator.
LOG_FORMAT=console
LOG_LEVEL=DEBUG

# ------------------------------------------------- backend/docker-entrypoint.sh
# Overridden per environment in docker-compose.yml / docker-compose.prod.yml.
RUN_MIGRATIONS=1
RUN_COLLECTSTATIC=1
# Set to 1 for one boot to populate demo data (manage.py seed_demo).
RUN_SEED_DEMO=0
DB_WAIT_RETRIES=60
DB_WAIT_DELAY=2

# --------------------------------------------------- Celery (fon vazifalar)
# ADR 0012. Bo'sh qoldirilsa compose'dagi REDIS_URL ishlatiladi. Navbatni
# channels/cache trafigidan ajratish uchun boshqa DB indeksi tavsiya etiladi:
#   CELERY_BROKER_URL=redis://redis:6379/1
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

# Soft-delete qilingan Task/Comment/Message shu kundan keyin BUTUNLAY o'chadi
# (ADR 0003). 0 yoki manfiy = tozalash O'CHIQ — "hammasini o'chir" DEGANI EMAS.
SOFT_DELETE_RETENTION_DAYS=30
# PURGE_BATCH_SIZE=500

# ------------------------------------------------------ Vite SPA (BUILD time)
# These are inlined into the client bundle by `vite build` (ADR 0011). Changing
# them means `docker compose up -d --build frontend`, not a restart — the
# running container is nginx serving already-built files and never reads them.
# They must be reachable from the BROWSER, so never use the `backend` service
# name here.
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000
VITE_API_MODE=real

# --------------------------------------------------------- host port mapping
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Only read when DEBUG=False (i.e. docker-compose.prod.yml) ---
# Leave SECURE_SSL_REDIRECT at its default (True): settings.py also enables
# SECURE_PROXY_SSL_HEADER, so a proxy that forwards `X-Forwarded-Proto: https`
# is seen as secure and nothing is redirected. Only set it to False if your
# proxy does NOT send that header — otherwise you get a redirect loop.
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SESSION_COOKIE_AGE=43200
